# Project Environment Configuration
PROJECT_NAME="The Lenny Growth Assistant"
API_V1_STR="/api"

# LLM Provider Configuration ('ollama', 'anthropic', 'openai')
DEFAULT_PROVIDER="ollama"
DEFAULT_MODEL="llama3.2"

# Ollama Local Configuration
OLLAMA_BASE_URL="http://localhost:11434"

# Cloud Provider API Keys (Optional - Can also be configured directly in the UI)
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""

# Database Configuration (Supports PostgreSQL / Supabase / Railway, with automatic local SQLite fallback)
# Default for zero-setup local evaluation (creates local lenny_growth.db automatically):
DATABASE_URL="sqlite+aiosqlite:///./lenny_growth.db"

# To connect to your Supabase PostgreSQL database, uncomment and set your DATABASE_URL below:
# Format: postgresql://postgres.[PROJECT_REF]:[YOUR_PASSWORD]@[REGION].pooler.supabase.com:5432/postgres
# Example: DATABASE_URL="postgresql://postgres.lfxgpmkitxqcbwcuwswi:YOUR_PASSWORD@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres"
