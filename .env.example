# Project Environment Configuration
PROJECT_NAME="The Lenny Growth Assistant"
API_V1_STR="/api"

# LLM Provider Configuration ('ollama', 'anthropic', 'openai')
DEFAULT_PROVIDER="ollama"
DEFAULT_MODEL="llama3.2"

# Ollama Local Configuration
OLLAMA_BASE_URL="http://localhost:11434"

# Cloud Provider API Keys (Optional - Can also be configured directly in the UI)
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""

# Database Configuration (Supports PostgreSQL / Supabase / Railway, with automatic SQLite fallback)
# Supabase / Railway Postgres Connection String Format:
# DATABASE_URL="postgresql://postgres:password@db.supabase.co:5432/postgres"
DATABASE_URL="sqlite+aiosqlite:///./lenny_growth.db"
